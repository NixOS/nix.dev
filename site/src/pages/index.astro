---
import Page from "../layouts/Page.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Laptop from "@lucide/astro/icons/laptop";
import Package from "@lucide/astro/icons/package";
import TriangleExclamationPoint from "@lucide/astro/icons/triangle-exclamation-point";
import NixSnowflake from "../assets/nix-snowflake.svg";
import Logo from "../assets/nixos-logo.svg";
---

<Page toc={false} sidebar={false}>
  <div
    class="border-l-2 border-mahogany-40 dark:border-mahogany-50 pl-4 py-1 my-6"
  >
    <div class="mb-2">
      <TriangleExclamationPoint size="1em" class="mr-2 inline" />
      <strong>Attention</strong>
    </div>
    <span>This website is a work-in-progress. </span>
    <a
      href="https://github.com/nixos/nix.dev"
      target="_blank"
      rel="noopener noreferrer">Contributions are welcome.</a
    >
  </div>
  <Logo height="200" class="my-16 mx-auto" />
  <div class="grid md:grid-cols-3 gap-4">
    <a
      href="/nix"
      class="border border-grey-10 dark:border-grey-90 hover:border-blue-30 dark:hover:border-blue-60 p-3"
      style="color: unset"
    >
      <div class="mb-2 flex gap-x-2 items-center">
        <NixSnowflake width="1em" height="1em" />
        <strong class="grow">Nix</strong>
        <ArrowRight size="1em" />
      </div>
      <div>The Nix language, CLI, store, and package management.</div>
    </a>

    <a
      href="/nixos"
      class="border border-grey-10 dark:border-grey-90 hover:border-blue-30 dark:hover:border-blue-60 p-3"
      style="color: unset"
    >
      <div class="mb-2 flex gap-x-2 items-center">
        <Laptop size="1em" />
        <strong class="grow">NixOS</strong>
        <ArrowRight size="1em" />
      </div>
      <div>
        The Linux distribution built on Nix: configuration and administration.
      </div>
    </a>

    <a
      href="/nixpkgs/preface"
      class="border border-grey-10 dark:border-grey-90 hover:border-blue-30 dark:hover:border-blue-60 p-3"
      style="color: unset"
    >
      <div class="mb-2 flex gap-x-2 items-center">
        <Package size="1em" />
        <strong class="grow">Nixpkgs</strong>
        <ArrowRight size="1em" />
      </div>
      <div>
        The package collection: lib functions, build helpers, hooks, and
        language frameworks.
      </div>
    </a>
  </div>
</Page>
