---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";

import Page from "../../layouts/Page.astro";
import {
  asCollection,
  findCollection,
  findTrail,
  leaves,
  loadDocIndex,
  MANUALS,
  type Manual,
} from "../../lib/nixpkgs-doc";

export type Props = { manual: Manual; page: CollectionEntry<Manual> };

export const getStaticPaths = (async () => {
  const manuals = Object.keys(MANUALS) as Manual[];
  const paths = await Promise.all(
    manuals.map(async (manual) =>
      (await getCollection(manual)).map((page) => ({
        params: { manual, slug: page.id },
        props: { manual, page },
      })),
    ),
  );
  return paths.flat();
}) satisfies GetStaticPaths;

const { manual, page } = Astro.props;
const { Content, headings } = await render(page);

// The index page of a collection lists the entries of the collection as cards.
const href = `/${manual}/${page.id}`;
const { tree } = await loadDocIndex(manual);
const collection = findCollection(tree, href);
const cards =
  collection?.index.href === href ? leaves(collection.entries) : undefined;

// A collection crumb links to the index page. On the index page itself the
// page title is the last crumb, so the collection crumb drops out.
const crumbs = (findTrail(tree, href) ?? []).flatMap((group) => {
  const index = asCollection(group)?.index.href;
  return index === href ? [] : [{ label: group.label, href: index }];
});
---

<Page title={page.data.title} headings={headings}>
  <nav
    slot="breadcrumbs"
    aria-label="Breadcrumb"
    class="mt-4 flex flex-wrap gap-x-1.5 text-sm text-grey-55 dark:text-grey-28"
  >
    <a href={`/${manual}/preface`} style="color: unset">
      {MANUALS[manual].label}
    </a>
    {
      crumbs.map((crumb) => (
        <>
          <span aria-hidden="true">/</span>
          {crumb.href ? (
            <a href={crumb.href} style="color: unset">
              {crumb.label}
            </a>
          ) : (
            <span>{crumb.label}</span>
          )}
        </>
      ))
    }
    <span aria-hidden="true">/</span>
    <span aria-current="page" class="text-grey-73 dark:text-grey-08">
      {page.data.title}
    </span>
  </nav>
  <Content />
  {
    cards && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 my-8">
        {cards.map((card) => (
          <a
            href={card.href}
            class="rounded-xs border border-grey-22 dark:border-grey-64 hover:border-grey-39 dark:hover:border-grey-51 p-3"
            style="color: unset"
          >
            <strong>{card.title}</strong>
          </a>
        ))}
      </div>
    )
  }
</Page>
