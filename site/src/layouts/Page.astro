---
import Base from "../layouts/Base.astro";
import TableOfContents from "../components/TableOfContents.astro";

const {
  title,
  description,
  headings = [],
  toc = true,
  sidebar = true,
} = Astro.props;
---

<Base title={title} description={description} sidebar={sidebar}>
  <main id="main-content" class="max-w-measure mx-auto">
    <slot name="breadcrumbs" />
    {
      title && (
        <hgroup class="my-4">
          <h1 class="text-h1 leading-tight text-balance">{title}</h1>
        </hgroup>
      )
    }
    <article class:list={[Astro.props.class, "prose"]}>
      <slot />
    </article>
  </main>
  <section class:list={["hidden", toc ? "lg:block" : ""]}>
    <TableOfContents
      headings={headings}
      class="sticky top-16 py-4 text-sm text-grey-60 dark:text-grey-40"
    />
  </section>
</Base>

<style>
  @reference "../styles/global.css";

  .prose {
    line-height: 1.6;

    /* A heading sits closer to its own section than to the section before.
     * The margins are in em, so they shrink with the heading size.
     */
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      text-wrap: balance;
      line-height: 1.25;
      margin-top: 2em;
      margin-bottom: 0.5em;
    }

    /* h1 is page title and should not be used in prose container */

    h2 {
      font-size: var(--text-h2);
    }

    h3 {
      font-size: var(--text-h3);
    }

    h4 {
      font-size: var(--text-h4);
    }

    h5 {
      font-size: var(--text-h5);
    }

    h6 {
      font-size: 1rem;
    }

    p {
      margin-bottom: 1rem;
    }

    p,
    li {
      text-wrap: pretty;
    }

    strong {
      font-weight: 500;
    }

    a {
      @apply text-blue-30 dark:text-blue-60;
    }

    ol {
      /* marker outside, shifted back inside, shifted more for two-digit marker */
      list-style-type: decimal;
      list-style-position: outside;
      margin-block: 1.25rem;
      margin-left: 1.5rem;

      li {
        padding-left: 0.25rem;
      }

      &:has(li:nth-last-child(n + 10)) {
        margin-left: 3.75rem;
      }
    }

    ul {
      /* marker outside but shifted back inside (so li aligns) */
      list-style-type: disc;
      list-style-position: outside;
      margin-block: 0.75rem;
      margin-left: 1rem;
    }

    li {
      display: list-item;
      margin-block: 0rem;

      &::marker {
        font-variant-numeric: lining-nums;
      }

      /* spacing for nested lists */
      & ol,
      & ul {
        margin-left: 1rem;
        margin-block: 0rem;
      }

      & p {
        display: inline;
      }

      & :global(p + p),
      & :global(p + blockquote) {
        display: block;
        margin-top: 1rem;
      }
    }

    .footnotes ol {
      margin-top: 0rem;
      margin-left: 1rem;
    }

    dl {
      margin-block: 0.75rem;
    }

    dt {
      font-weight: 500;
      margin-top: 0.75rem;
    }

    dd {
      margin-left: 1rem;
    }

    blockquote {
      margin-block: 1rem;
      padding-left: 1rem;
      border-inline-start-width: 2px;
      @apply border-grey-10 dark:border-grey-90;
    }

    .expressive-code {
      @apply my-4;
    }

    /* Code in a heading keeps the size of the heading and gets no box */
    code:not(pre code, :is(h2, h3, h4, h5, h6) code),
    kbd {
      padding: 0.125em 0.3em;
      border-radius: 0.25rem;
      @apply bg-grey-05 dark:bg-steel-90 text-[0.875em] wrap-break-word;
    }

    kbd {
      @apply border-1 border-grey-40 dark:border-grey-60;
    }

    section.footnotes {
      margin-top: 2rem;
      padding-top: 2rem;
      border-top-width: 2px;
      @apply border-grey-10 dark:border-grey-90;

      * {
        font-size: 0.8rem;
      }
    }

    table {
      @apply text-sm md:text-base;
      table-layout: auto;
      width: 100%;

      th {
        padding-inline: 0.5rem;
        padding-bottom: 0.5rem;
        font-weight: 500;
        vertical-align: bottom;

        &:first-child {
          padding-left: 0rem;
        }

        &:last-child {
          padding-right: 0rem;
        }
      }

      tbody td,
      tfoot td {
        padding: 0.25rem 0.5rem;
        vertical-align: top;

        &:first-child {
          padding-left: 0rem;
        }

        &:last-child {
          padding-right: 0rem;
        }
      }

      caption {
        caption-side: bottom;
      }
    }

    mark {
      padding: 0.1rem;
      @apply bg-blue-60 dark:bg-blue-30 dark:text-grey-95;
    }

    abbr {
      cursor: help;
    }

    /* Headings followed directly by headings of lower rank should not be
   * separated by extra space. Need to use `:global()` because Astro makes
   * sibling combinators too specific.
   */
    :global(h2 + :is(h3, h4, h5, h6)),
    :global(h3 + :is(h4, h5, h6)),
    :global(h4 + :is(h5, h6)),
    :global(h5 + h6) {
      margin-top: 0rem;
    }

    /* Let container determine top-spacing (also handles h1 + h2) */
    & :first-child {
      margin-top: 0;
    }
  }
</style>
