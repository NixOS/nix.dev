---
import Head from "../components/Head.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";

const { title, description, sidebar = true } = Astro.props;
---

<html lang="en">
  <Head title={title} description={description} />
  <body
    class="flex flex-col min-h-dvh font-sans
    bg-grey-01 text-grey-79 dark:bg-grey-87 dark:text-grey-08"
  >
    <div
      class="px-4 flex-grow gap-x-4
        md:grid md:grid-cols-[2fr_5fr] md:grid-rows-[1fr_auto] lg:grid-cols-page"
    >
      <section class="hidden md:block md:row-span-2">
        {sidebar && <Sidebar class="pt-4 md:sticky md:top-0 md:h-dvh" />}
      </section>
      <slot />
      <Footer class="mx-auto mt-8 w-full max-w-measure py-4 md:col-start-2" />
    </div>
  </body>
</html>
