---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";

const { title, description } = Astro.props;
---

<html lang="en">
  <Head title={title} description={description} />
  <body
    class="flex flex-col min-h-dvh gap-y-8 font-sans
    bg-grey-02 text-black dark:bg-steel-95 dark:text-mainsail-10"
  >
    <Header class="px-4 fixed" />
    <div
      class="px-4 mt-16 flex-grow gap-x-4
        md:grid md:grid-cols-[2fr_5fr] lg:grid-cols-page"
    >
      <section
        class:list={[
          "fixed md:static",
          "bg-grey-05 dark:bg-steel-90 md:bg-inherit md:dark:bg-inherit",
          "left-0 top-14 bottom-0 overflow-y-auto md:overflow-y-visible",
          "px-4 md:px-0",
          "w-full",
          "z-2",
          "hidden md:block",
        ]}
        x-data
        :class="$store.nav.open ? '!block' : ''"
      >
        <Sidebar
          class="h-full pt-4 md:sticky md:top-16 md:h-[calc(100dvh-4rem)]"
        />
      </section>
      <slot />
    </div>
    <Footer class="p-4" />
  </body>
</html>
