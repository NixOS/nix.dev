---

import nav from "../nav.json";
import TableOfContentsItem from "./TableOfContentsItem.astro";
---

<nav class:list={[Astro.props.class]}>
  <ol id="section-nav" class="[&_li]:hover:opacity-80">
    <li><a href="https://nix.dev">Nix</a></li>
    <li><a href="https://nixos.org/manual/nixos/unstable">NixOS</a></li>
    <li><a href="https://nixos.org/manual/nixpkgs/unstable">Nixpkgs</a></li>
  </ol>
  <hr class="w-[80%] m-4 opacity-50">
  <ol id="pages-nav">
    { nav.map(item =>
        <TableOfContentsItem
          item={item}
          stackSlugs={true}
          slugPrefix="/"
        />
      )
    }
  </ol>
</nav>
