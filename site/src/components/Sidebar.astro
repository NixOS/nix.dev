---
import NixpkgsNavTree from "./NixpkgsNavTree.astro";
import { loadDocIndex } from "../lib/nixpkgs-doc";

const current = Astro.url.pathname.replace(/\/+$/, "");
const inNixpkgs =
  current.startsWith("/nixpkgs") || current.startsWith("/reference");
const tree = inNixpkgs ? (await loadDocIndex()).tree : undefined;
---

<nav class:list={[Astro.props.class]}>
  <ol id="section-nav" class="[&_li]:hover:opacity-80">
    <li><a href="/nix">Nix</a></li>
    <li><a href="/nixos">NixOS</a></li>
    <li>
      <a href="/nixpkgs">Nixpkgs</a>
      {tree && <NixpkgsNavTree nodes={tree} current={current} />}
    </li>
  </ol>
</nav>
