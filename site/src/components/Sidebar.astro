---
import ChevronLeft from "@lucide/astro/icons/chevron-left";
import ExternalLink from "@lucide/astro/icons/external-link";
import NixpkgsNavTree from "./NixpkgsNavTree.astro";
import { findCollection, loadDocIndex, MANUALS } from "../lib/nixpkgs-doc";

const current = Astro.url.pathname.replace(/\/+$/, "");
const inside = (path: string) =>
  current === path || current.startsWith(`${path}/`);
const topics = [
  { label: "NixOS", href: "/nixos/preface", active: inside("/nixos") },
  { label: "Nixpkgs", href: "/nixpkgs/preface", active: inside("/nixpkgs") },
  // Nix manual lives on nix.dev until the Nix topic is migrated.
  {
    label: "Nix",
    href: "https://nix.dev/manual/nix/latest/",
    active: false,
    external: true,
  },
];
const manual = inside("/nixos")
  ? "nixos"
  : inside("/nixpkgs")
    ? "nixpkgs"
    : undefined;
const tree = manual ? (await loadDocIndex(manual)).tree : undefined;
// A page inside a collection opens the sidebar on the collection's own list.
const collection = tree && findCollection(tree, current);
---

<nav class:list={[Astro.props.class, "flex flex-col"]}>
  <ul
    id="section-nav"
    aria-label="Topic"
    class="grid shrink-0 grid-cols-3 gap-0.5 rounded-[3px] bg-grey-05 p-[3px] dark:bg-grey-78"
  >
    {
      topics.map(({ label, href, active, external }) => (
        <li>
          <a
            href={href}
            aria-current={active ? "true" : undefined}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener" : undefined}
            aria-label={
              external
                ? `${label} manual, opens nix.dev in a new tab`
                : undefined
            }
            class:list={[
              "flex h-9 items-center justify-center gap-[5px] rounded-xs text-[0.9375rem]",
              "focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-blue-15 dark:focus-visible:outline-blue-65",
              active
                ? "bg-blue-70 text-grey-82 dark:bg-blue-65 dark:text-grey-87"
                : "text-grey-71 hover:opacity-80 dark:text-grey-17",
            ]}
          >
            {label}
            {external && (
              <ExternalLink
                size={13}
                stroke-width={2.2}
                aria-hidden="true"
                class="shrink-0"
              />
            )}
          </a>
        </li>
      ))
    }
  </ul>
  {
    tree && (
      <div
        x-data={`{ showCollection: ${!!collection} }`}
        class="mt-4 flex min-h-0 flex-1 flex-col [&_:is(a,summary,button)]:hover:opacity-80 [&_:is(summary,button)]:cursor-pointer"
      >
        <div
          x-show="!showCollection"
          x-cloak={collection ? "" : undefined}
          class="min-h-0 flex-1 overflow-y-auto pb-4"
        >
          <NixpkgsNavTree nodes={tree} current={current} parts />
        </div>
        {collection && (
          <div x-show="showCollection" class="flex min-h-0 flex-1 flex-col">
            {/* The collection header stays put while its list scrolls. */}
            <div class="shrink-0">
              <button
                type="button"
                class="flex items-center gap-1 px-2.5 py-1 text-xs text-grey-62 dark:text-grey-28"
                x-on:click="showCollection = false"
              >
                <ChevronLeft size="1em" />
                Back
              </button>
              <div class="mb-2 border-b border-grey-22 dark:border-grey-64 px-2.5 pt-2.5 pb-3">
                <div class="text-xs text-grey-62 dark:text-grey-28">
                  <a href={`/${manual}/preface`}>{MANUALS[manual!].label}</a>
                  {collection.ancestors.map((group) => ` › ${group.label}`)}
                </div>
                <div class="mt-0.5 text-xl text-grey-82 dark:text-grey-03">
                  {collection.group.label}
                </div>
              </div>
            </div>
            <div class="min-h-0 flex-1 overflow-y-auto pb-4">
              <NixpkgsNavTree
                nodes={[
                  { href: collection.index.href, title: "Overview" },
                  ...collection.entries,
                ]}
                current={current}
              />
            </div>
          </div>
        )}
      </div>
    )
  }
</nav>
