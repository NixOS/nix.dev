---
type SocialIcon = {
  text: string;
  href: string;
  icon: (props: { width: string; height: string }) => unknown;
};

interface Props {
  items: SocialIcon[];
  class?: string | string[];
}

const { items = [] } = Astro.props;
---

<span class:list={[Astro.props.class, "flex gap-x-4"]}>
  {
    items.map(({ text, href, icon: Icon }) => (
      <a
        class="flex gap-x-1.5 flex-row max-w-fit"
        href={href}
        title={text}
        aria-label={text}
      >
        <Icon width="1.5rem" height="1.5rem" />
      </a>
    ))
  }
</span>
