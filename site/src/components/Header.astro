---
import SiteTitle from "../components/SiteTitle.astro";
import SocialIcons from "../components/SocialIcons.astro";
import Search from "../components/Search.astro";
import ThemeSelector from "../components/ThemeSelector.astro";
import MobileMenuToggle from "../components/MobileMenuToggle.astro";

import { config } from "../site.config.ts";
---

<header
  class:list={[
    Astro.props.class,
    "bg-grey-05 dark:bg-steel-90",
    "w-full",
    "z-3",
  ]}
>
  <div
    class:list={[
      "gap-x-4 flex flex-row",
      "md:grid md:grid-cols-[5fr_2fr] lg:grid-cols-[1fr_3fr_1fr]",
    ]}
  >
    <span id="header-left" class="grow">
      <SiteTitle class="h-full items-center" />
    </span>

    <span
      id="header-middle"
      class:list={[
        "flex justify-between gap-x-4",
        "place-self-center items-center",
        "md:w-full max-w-[80ch]",
      ]}
    >
      <Search class="w-full lg:w-fit" />
      <MobileMenuToggle class="md:hidden" />
    </span>

    <span
      id="header-right"
      class="hidden lg:flex flex-row gap-x-4 justify-between items-center"
    >
      <SocialIcons items={config.headerLinks} />
      <ThemeSelector />
    </span>
  </div>
</header>
