---
type Item = {
  slug: string;
  text?: string;
  depth?: number;
  children?: Item[];
};

interface Props {
  item: Item;
  maxDepth?: number;
  slugPrefix?: string;
  stackSlugs?: boolean;
}

const {
  item,
  maxDepth = 99,
  slugPrefix = "",
  stackSlugs = false,
} = Astro.props;
---

<li class="flex flex-col gap-0.5">
  <a
    href={`${slugPrefix}${item.slug}`}
    class="grid py-1.25 text-grey-51 transition-colors duration-120
      hover:text-grey-82 aria-current:font-semibold aria-current:text-blue-15
      focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-15
      dark:text-grey-39 dark:hover:text-grey-03 dark:aria-current:text-blue-65
      dark:focus-visible:outline-blue-65"
  >
    {
      /* A hidden semibold copy in the same grid cell sizes the row for the
    current weight, so marking a link never changes the height/layout of a row. */
    }
    <span class="col-start-1 row-start-1">{item.text ?? item.slug}</span>
    <span class="invisible col-start-1 row-start-1 font-semibold">
      {item.text ?? item.slug}
    </span>
  </a>

  {
    (item.depth ?? 0) < maxDepth &&
      item.children &&
      item.children.length !== 0 && (
        <ol class="flex flex-col gap-0.5 pl-5">
          {item.children.map((child) => {
            const slug = stackSlugs ? `${item.slug}/${child.slug}` : child.slug;
            return (
              <Astro.self
                item={{ ...child, slug }}
                maxDepth={maxDepth}
                slugPrefix={slugPrefix}
                stackSlugs={stackSlugs}
              />
            );
          })}
        </ol>
      )
  }
</li>
