---
type Item = {
  slug: string;
  text?: string;
  depth?: number;
  children?: Item[];
};

interface Props {
  item: Item;
  collapseDepth?: number;
  maxDepth?: number;
  slugPrefix?: string;
  stackSlugs?: boolean;
}

const {
  item,
  collapseDepth = 3,
  maxDepth = 99,
  slugPrefix = "",
  stackSlugs = false,
} = Astro.props;
---

<li>
  <details>
    <summary>
      <a href={`${slugPrefix}${item.slug}`}>
        {item.text ?? item.slug}
      </a>
    </summary>

    {
      (item.depth ?? 0) < maxDepth &&
        item.children &&
        item.children.length !== 0 && (
          <ol>
            {item.children.map((child) => {
              const slug = stackSlugs
                ? `${item.slug}/${child.slug}`
                : child.slug;
              return (
                <Astro.self
                  item={{ ...child, slug }}
                  maxDepth={maxDepth}
                  slugPrefix={slugPrefix}
                  stackSlugs={stackSlugs}
                />
              );
            })}
          </ol>
        )
    }
  </details>
</li>

<style>
  @reference "../styles/global.css";

  ol {
    @apply ml-4;
  }
</style>
