---
import { config } from "../site.config.ts";

const today = new Date();
---

<footer
  class:list={[
    Astro.props.class,
    "flex flex-col sm:flex-row gap-x-4 gap-y-1 justify-between",
  ]}
>
  <span>
    {`Copyright © ${today.getFullYear()} ${config.copyright.author}, `}
    <a class="break-keep" href={config.copyright.license.href}
      >{config.copyright.license.text}</a
    >
  </span>

  <span class="flex gap-x-4">
    {config.footerLinks.map(({ text, href }) => <a href={href}>{text}</a>)}
  </span>
</footer>
