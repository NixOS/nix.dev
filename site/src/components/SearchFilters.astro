---
import { CATEGORIES } from "../lib/search";

interface Props {
  class?: string;
  /** Classes for each button, on top of the shared ones. */
  button: string;
}

const filters = [
  { label: "All", value: "" },
  ...CATEGORIES.map((category) => ({ label: category, value: category })),
];

const button = [
  "group flex cursor-pointer py-[3px] text-left text-sm leading-[22px]",
  "text-grey-57 hover:text-blue-15 aria-pressed:text-blue-15",
  "dark:text-grey-28 dark:hover:text-blue-65 dark:aria-pressed:text-blue-65",
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-15 dark:focus-visible:outline-blue-65",
  Astro.props.button,
];
---

<nav hidden aria-label="Filter" data-filters class={Astro.props.class}>
  <slot />
  {
    filters.map(({ label, value }) => (
      <button
        type="button"
        data-category={value}
        aria-pressed="false"
        class:list={button}
      >
        <span class="inline-grid">
          <span class="col-start-1 row-start-1 group-aria-pressed:font-semibold">
            {label}
          </span>
          <span
            aria-hidden="true"
            class="invisible col-start-1 row-start-1 font-semibold"
          >
            {label}
          </span>
        </span>
        <span
          data-count
          class="tabular-nums group-aria-pressed:font-semibold"
        />
      </button>
    ))
  }
</nav>
